{
  "name": "webmote",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:bun": "bun --watch server/index.ts",
    "start": "tsx server/index.ts",
    "start:bun": "bun server/index.ts",
    "build:binary": "bun build --compile server/index.ts --outfile webmote",
    "build": "tsc"
  },
  "dependencies": {
    "androidtv-remote": "^1.0.10",
    "crypto-js": "^4.2.0",
    "node-forge": "^1.4.0",
    "protobufjs": "^8.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.13.5",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.5.14",
    "bun-types": "^1.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
